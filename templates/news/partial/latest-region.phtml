        if ($article['city_url'] === 'cely-ms-kraj') {
            $region_city_url = $view->path('news');
        }

        try {
            $today = new DateTime();
            $dateUpdate = new DateTime($article['updated_date']);
            if ($today->format('Y-m-d') === $dateUpdate->format('Y-m-d')) {
                $dayUpdate = 'Dnes';
            } else {
                $yesterday = new DateTime();
                $yesterday->modify('-1 day');
                if ($yesterday->format('Y-m-d') === $dateUpdate->format('Y-m-d')) {
                    $dayUpdate = 'Včera';
                } else {
                    $dayUpdate = (new IntlDateFormatter($locale, IntlDateFormatter::LONG, IntlDateFormatter::NONE))->format($dateUpdate);
                }
            }
            $timeUpdate = (new IntlDateFormatter($locale, IntlDateFormatter::NONE, IntlDateFormatter::SHORT))->format($dateUpdate);

            $today = new DateTime();
            $date = new DateTime($article['public_from']);
            if ($today->format('Y-m-d') === $date->format('Y-m-d')) {
                if ($article['label']) {
                    $day = 'dnes';
                } else {
                    $day = 'Dnes';
                }
            } else {
                $yesterday = new DateTime();
                $yesterday->modify('-1 day');
                if ($yesterday->format('Y-m-d') === $date->format('Y-m-d')) {
                    if ($article['label']) {
                        $day = 'včera';
                    } else {
                        $day = 'Včera';
                    }
                } else {
                    $day = (new IntlDateFormatter($locale, IntlDateFormatter::LONG, IntlDateFormatter::NONE))->format($date);
                }
            }
            $time = (new IntlDateFormatter($locale, IntlDateFormatter::NONE, IntlDateFormatter::SHORT))->format($date);
        } catch (Exception $e) {
            $day = 'NaN';
            $time = 'NaN';
            $dayUpdate = 'NaN';
            $timeUpdate = 'NaN';
        }
        ?>

