// Url
$view->addInlineScript(
    '$("#btnGetUrl").click(function(e){
        e.preventDefault();
        let title = $("input[name=title]").val();
        if (title === "") {
            var notice = new PNotify({
                title: "Chyba",
                text: "Nejprve vyplňte název!",
                type: "error",
                addclass: "click-2-close",
                buttons: {
                    sticker: false
                }
            });
        } else {
            $.post("' . $view->path('admin_page_get_url') . '",
                {
                    title: title
                },
                function(json) {
                    if (json.success) {
                        $("input[name=url]").val(json.url);
                    } else {
                        var notice = new PNotify({
                            title: "Chyba",
                            text: "Nelze získat název!",
                            type: "error",
                            addclass: "click-2-close",
                            buttons: {
                                sticker: false
                            }
                        });
                    }
                }, 
                "json"      
            );
        }
    });'
);
