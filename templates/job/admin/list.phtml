            <script>
                function datetimeFormatter(value, row) {
                    return moment(value).format('llll');
                }
                function dateFormatter(value, row) {
                    if (value !== null && value !== undefined) {
                        return moment(value).format('ll');
                    }
                }
                function floatFormatter(value, row) {
                    if (value !== null && value !== undefined) {
                        return number_format(value, 1, ',', ' ');
                    }
                }
                function boolFormatter(value, row) {
                    if (value === 1) {
                            return '<i class="fa fa-fw fa-check-circle text-success" data-toggle="tooltip" title="Ano"></i>';
                    } else {
                            return '<i class="fa fa-fw fa-times-circle text-danger" data-toggle="tooltip" title="Ne"></i>';
                    }
                }
                function wageFormatter(value, row) {
                    if (value && row.mesicniMzdaDo) {
                        return number_format(value, 0, ',', ' ') + ' - ' + number_format(row.mesicniMzdaDo, 0, ',', ' ') + '<br><small class="text-muted">(' + row.typMzdy + ')</small>';
                    } else {
                        return number_format(value, 0, ',', ' ') + '<br><small class="text-muted">(' + row.typMzdy + ')</small>';
                    }
                }
                function terminFormatter(value, row) {
                    if (value && row.terminUkonceniPracovnihoPomeru) {
                        return moment(value).format('ll') + '<br>' + moment(row.terminUkonceniPracovnihoPomeru).format('ll');
                    } else {
                        return moment(value).format('ll');
                    }
                }
                function profeseFormatter(value, row) {
                    if (value && row.upresnujiciInformace) {
                        return value + '<br><small class="text-muted">(' + row.profeseCzIsco + ')</small>';
                    } else {
                        return value;
                    }
                }
                function arrayFormatter(value, row) {
                    if (value !== null && value !== undefined) {
                        let text = '';
                        value.forEach(function (item) {
                            text += item + '<br>';
                        });
                        return text;
                    } else {
                        return null;
                    }
                }
                function linkFormatter(value, row) {
                    if (value !== null && value !== undefined) {
                        return '<a href="' + value + '" target="_blank"><i class="fa fa-fw fa-external-link"></i></a>';
                    } else {
                        return null;
                    }
                }
                function employerFormatter(value, row) {
                    return value + '<br>' + row.zamestnavatel_ico;
                }
                function mistoFormatter(value, row) {
                    let text = '';
                    if (value !== null && value !== undefined) {
                        text += value + '<br>';
                    }
                    if (row.mistoVykonuPrace_pracoviste_adresa_ulice !== null && row.mistoVykonuPrace_pracoviste_adresa_ulice !== undefined) {
                        text += row.mistoVykonuPrace_pracoviste_adresa_ulice;
                        if (row.mistoVykonuPrace_pracoviste_adresa_cisloDomovni !== null && row.mistoVykonuPrace_pracoviste_adresa_cisloDomovni !== undefined) {
                            text += ' ' + row.mistoVykonuPrace_pracoviste_adresa_cisloDomovni;
                        }
                        if (row.mistoVykonuPrace_pracoviste_adresa_cisloOrientacni !== null && row.mistoVykonuPrace_pracoviste_adresa_cisloOrientacni !== undefined) {
                            text += ' / ' + row.mistoVykonuPrace_pracoviste_adresa_cisloOrientacni;
                        }
                        text += '<br>';
                    }
                    if (row.mistoVykonuPrace_pracoviste_adresa_obec !== null) {
                        text += row.mistoVykonuPrace_pracoviste_adresa_obec;
                        if (row.mistoVykonuPrace_pracoviste_adresa_castObce !== null && row.mistoVykonuPrace_pracoviste_adresa_obec !== row.mistoVykonuPrace_pracoviste_adresa_castObce) {
                            text += ' - ' + row.mistoVykonuPrace_pracoviste_adresa_castObce;
                        }
                    }
                    if (row.mistoVykonuPrace_pracoviste_adresa_psc !== null) {
                        text += ', ' + row.mistoVykonuPrace_pracoviste_adresa_psc.substr(0, 3) + ' ' + row.mistoVykonuPrace_pracoviste_adresa_psc.substr(3, 2);
                    }
                    text += '<br>';
                    if (row.mistoVykonuPrace_pracoviste_adresa_okres !== null) {
                        text += row.mistoVykonuPrace_pracoviste_adresa_okres + '<br>';
                    }
                    if (row.mistoVykonuPrace_pracoviste_adresa_kraj !== null) {
                        text += row.mistoVykonuPrace_pracoviste_adresa_kraj + '<br>';
                    }
                    if (row.mistoVykonuPrace_pracoviste_telefon !== null) {
                        text += row.mistoVykonuPrace_pracoviste_telefon + '<br>';
                    }
                    if (row.mistoVykonuPrace_pracoviste_email !== null) {
                        text += row.mistoVykonuPrace_pracoviste_email;
                    }
                    return text;
                }
                function firstContactFormatter2(value, row) {
                    let text = '';
                    if (row.prvniKontaktSeZamestnavatelem_mistoKontaktu !== null) {
                        text += row.prvniKontaktSeZamestnavatelem_mistoKontaktu + '<br>';
                    }
                    if (row.prvniKontaktSeZamestnavatelem_titulPredJmenem !== null) {
                        text += row.prvniKontaktSeZamestnavatelem_titulPredJmenem + ' ';
                    }
                    if (row.prvniKontaktSeZamestnavatelem_jmenoKontaktniOsoby !== null) {
                        text += row.prvniKontaktSeZamestnavatelem_jmenoKontaktniOsoby + ' ';
                    }
                    if (row.prvniKontaktSeZamestnavatelem_prijmeniKontaktniOsoby !== null) {
                        text += row.prvniKontaktSeZamestnavatelem_prijmeniKontaktniOsoby;
                    }
                    if (row.prvniKontaktSeZamestnavatelem_titulZaJmenem !== null) {
                        text += ' ' + row.prvniKontaktSeZamestnavatelem_titulZaJmenem;
                    }
                    text += '<br>';
                    if (row.prvniKontaktSeZamestnavatelem_poziceVeSpolecnosti !== null) {
                        text += row.prvniKontaktSeZamestnavatelem_poziceVeSpolecnosti + '<br>';
                    }
                    if (row.prvniKontaktSeZamestnavatelem_kontaktniTelefon !== null) {
                        text += row.prvniKontaktSeZamestnavatelem_kontaktniTelefon + '<br>';
                    }
                    if (row.prvniKontaktSeZamestnavatelem_kontaktniEmail !== null) {
                        text += row.prvniKontaktSeZamestnavatelem_kontaktniEmail + '<br>';
                    }
                    return text;
                }
                function contactFormatter(value, row) {
                    let text = '';
                    if (row.kontaktniOsobaZamestnavatele_titulPredJmenem !== null) {
                        text += row.kontaktniOsobaZamestnavatele_titulPredJmenem + ' ';
                    }
                    if (row.kontaktniOsobaZamestnavatele_jmeno !== null) {
                        text += row.kontaktniOsobaZamestnavatele_jmeno + ' ';
                    }
                    if (row.kontaktniOsobaZamestnavatele_prijmeni !== null) {
                        text += row.kontaktniOsobaZamestnavatele_prijmeni;
                    }
                    if (row.kontaktniOsobaZamestnavatele_titulZaJmenem !== null) {
                        text += ' ' + row.kontaktniOsobaZamestnavatele_titulZaJmenem;
                    }
                    text += '<br>';
                    if (row.kontaktniOsobaZamestnavatele_poziceVeSpolecnosti !== null) {
                        text += row.kontaktniOsobaZamestnavatele_poziceVeSpolecnosti + '<br>';
                    }
                    return text;
                }
                function detailFormatter(index, row) {
                    let html = [];
                    html.push('<p>' + (row.upresnujiciInformace !== null ? row.upresnujiciInformace : '') + '</p>');
                    return html.join('');
                }
            </script>
