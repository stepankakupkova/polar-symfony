            <script>
                function enableFormatter(value) {
                    let icon = 'fa fa-fw fa-lg';
                    let color = 'text-success';
                    let text = '';
                    switch (value) {
                        case 1:
                            icon = 'fa fa-fw fa-lg fa-check-circle';
                            color = 'text-success';
                                text = 'Povoleno';
                            break;
                        case 0:
                            icon = 'fa fa-fw fa-lg fa-times-circle';
                            color = 'text-danger';
                                text = 'Zakázáno';
                            break;
                    }
                    return '<i class="' + icon + ' ' + color + '" data-toggle="tooltip" data-placement="right" title="' + text + '"></i>';
                }
                function companyFormatter(value, row) {
                    return value + '<br>' + row.company_in + '<br>' + row.company_street + '<br>' + row.company_city + ', ' + row.company_postcode;
                }
                function firstContactFormatter(value, row) {
                    let text = '';
                    if (row.person !== null) {
                        text += row.person + '<br>';
                    }
                    if (row.phone !== null) {
                        text += row.phone + '<br>';
                    }
                    if (row.email !== null) {
                        text += row.email;
                    }
                    return text;
                }
                function dateFormatter(value) {
                    if (value) {
                        return moment(value).format('LL');
                    }
                    return null;
                }
                function datetimeFormatter(value) {
                    if (value) {
                        return moment(value).format('LLLL');
                    }
                    return null;
                }
            </script>
