<?php
/**
 * Submenu — horní lišta (desktop) + mobile verze
 * Desktop: Živě Polar 1+2, Pořady, Multimedia, stránky z DB (Reklama, Kontakt),
 *          O TV POLAR dropdown (hamburger) s children z DB + statickými položkami
 * Mobile:  jen Živě Polar 1+2 (menší SVG)
 *
 * @param bool $mobile  true = mobilní verze (jen živě polar/polar2)
 */

$mobile = $mobile ?? false;

// Mobilní verze — pouze živě polar a polar2 s menšími ikonami
if ($mobile) {
    $mobileItems = [
        [
            'id'    => 'zivePolar',
            'label' => '<img src="/img/web/layout/header/zive-polar-small.svg" alt="Živě Polar">',
            'url'   => '/hd',
            'class' => '',
        ],
        [
            'id'    => 'zivePolar2',
            'label' => '<img src="/img/web/layout/header/zive-polar2-small.svg" alt="Živě Polar 2">',
            'url'   => '/polar2',
            'class' => 'hide-xs',
        ],
    ];
    $currentPath = parse_url($_SERVER['REQUEST_URI'], PHP_URL_PATH);
    foreach ($mobileItems as $item) { ?>
        <li class="nav-item nav-item-anim-icon">
            <a id="<?= $item['id'] ?>"
                class="<?= $item['class'] ?> text-secondary text-hover-primary text-3 nav-link text-decoration-none line-height-3 font-weight-500 px-1 px-md-2<?= str_starts_with($currentPath, $item['url']) ? ' active' : '' ?>"
                href="<?= htmlspecialchars($item['url']) ?>">
                <?= $item['label'] ?>
            </a>
        </li>
    <?php }
    return;
}

// Desktop verze — plné submenu
$nav = require dirname(__DIR__, 3) . '/config/navigation.php';
$items = $nav['submenu'];
$currentPath = parse_url($_SERVER['REQUEST_URI'], PHP_URL_PATH);

// Načtení dynamických page items z page_navigation.php
$pageNavFile = dirname(__DIR__, 3) . '/config/page_navigation.php';
$pageNav = file_exists($pageNavFile) ? require $pageNavFile : [];
$pageDropdown = $pageNav['submenu-dropdown'] ?? [];

// Najdi hamburger item v navigation.php (menuPageWeb-15)
$hamburgerKey = null;
foreach ($items as $k => $item) {
    if (isset($item['dropdown']) && ($item['id'] ?? '') === 'menuPageWeb-15') {
        $hamburgerKey = $k;
        break;
    }
}

// Přidej page items (Reklama, Kontakt) jako přímé nav linky (ty BEZ pages/children)
// a children z O TV POLAR (menuPageWeb-15) přidej do hamburger dropdown
foreach ($pageDropdown as $key => $pageItem) {
    if (!($pageItem['visible'] ?? 1)) { continue; }
    if (isset($pageItem['pages'])) {
        // Item s children (O TV POLAR) — přidej jeho children do hamburger dropdown
        if ($hamburgerKey !== null) {
            $children = $pageItem['pages'];
            uasort($children, fn($a, $b) => ($a['order'] ?? 0) <=> ($b['order'] ?? 0));
            foreach ($children as $child) {
                if (!($child['visible'] ?? 1)) { continue; }
                $items[$hamburgerKey]['dropdown'][] = [
                    'label' => $child['label'],
                    'url' => $view->path($child['route']),
                ];
            }
        }
    } else {
        // Přímý page item (Reklama, Kontakt) — vlož před hamburger
        $items[] = [
            'id'    => $pageItem['id'],
            'label' => $pageItem['label'],
            'url'   => $view->path($pageItem['route']),
            'class' => '',
            'order' => $pageItem['order'] ?? 99,
        ];
    }
}

// Seřadíme items podle order (stabilní řazení — zachová pořadí u stejného order)
$ordered = [];
$hamburgerItem = null;
foreach ($items as $item) {
    if (isset($item['dropdown'])) {
        $hamburgerItem = $item; // hamburger vždy na konec
    } else {
        $ordered[] = $item;
    }
}
usort($ordered, fn($a, $b) => ($a['order'] ?? 99) <=> ($b['order'] ?? 99));
if ($hamburgerItem) { $ordered[] = $hamburgerItem; }
$items = $ordered;
?>
<?php foreach ($items as $item) { ?>
    <?php
        $isHamburger = isset($item['dropdown']);

        $active = isset($item['url']) && $item['url'] !== '#' && str_starts_with($currentPath, $item['url']);
    ?>
    <?php if ($isHamburger) { ?>
        <li class="nav-item dropdown d-none d-sm-block">
            <a id="<?= $item['id'] ?>"
                class="nav-link dropdown-toggle text-secondary text-hover-primary text-3 text-decoration-none line-height-3 font-weight-500 px-1 px-md-2 p-0"
                href="#" role="button" data-bs-toggle="dropdown" rel="nofollow">
                <button class="btn sidenav-1">
                    <div class="animated-icon2"><span></span><span></span><span></span><span></span></div>
                </button>
            </a>
            <ul class="dropdown-menu">
                <?php foreach ($item['dropdown'] as $child) { ?>
                    <li>
                        <a class="dropdown-item<?= str_starts_with($currentPath, $child['url']) ? ' active' : '' ?>"
                            href="<?= htmlspecialchars($child['url']) ?>"
                            title="<?= htmlspecialchars($child['label']) ?>">
                            <?= htmlspecialchars($child['label']) ?>
                        </a>
                    </li>
                <?php } ?>
            </ul>
        </li>
    <?php } else { ?>
        <li class="nav-item nav-item-anim-icon">
            <a id="<?= $item['id'] ?>"
                class="<?= $item['class'] ?? '' ?> text-secondary text-hover-primary text-3 nav-link text-decoration-none line-height-3 font-weight-500 px-1 px-md-2<?= $active ? ' active' : '' ?>"
                href="<?= htmlspecialchars($item['url']) ?>"
                <?= isset($item['target']) ? 'target="' . $item['target'] . '"' : '' ?>>
                <?= $item['label'] ?>
            </a>
        </li>
    <?php } ?>
<?php } ?>
