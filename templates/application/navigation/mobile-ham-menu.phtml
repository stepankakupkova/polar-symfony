<?php
/**
 * Hamburger menu (mobily) — položky submenu ve 2 sloupcích
 * Prvních 5 položek vlevo, zbytek vpravo
 */
/** @var \App\Application\View\ViewHelper $view */

$nav = require dirname(__DIR__, 3) . '/config/navigation.php';
$currentPath = parse_url($_SERVER['REQUEST_URI'], PHP_URL_PATH);

// Načtení dynamických page items z page_navigation.php
$pageNavFile = dirname(__DIR__, 3) . '/config/page_navigation.php';
$pageNav = file_exists($pageNavFile) ? require $pageNavFile : [];
$pageDropdown = $pageNav['submenu-dropdown'] ?? [];

// Sestaví flat seznam položek v pořadí odpovídajícím Laminasu:
// Přímé submenu items (bez živě polar/polar2, multimedia) + dropdown children + page items
// V Laminasu šlo vše z jednoho navigation containeru v daném order.
$skipIds = ['zive-polar', 'multimedia'];
$items = [];

// 1) Přímé submenu položky (Pořady)
foreach ($nav['submenu'] as $item) {
    if (isset($item['dropdown'])) { continue; }
    if (in_array($item['id'] ?? '', $skipIds, true)) { continue; }
    $items[] = ['label' => $item['label'], 'url' => $item['url'], 'id' => $item['id'], 'target' => $item['target'] ?? null, 'order' => $item['order'] ?? 99];
}

// 2) Přímé page items (Reklama, Kontakt)
foreach ($pageDropdown as $pageItem) {
    if (!($pageItem['visible'] ?? 1) || isset($pageItem['pages'])) { continue; }
    $items[] = ['label' => $pageItem['label'], 'url' => $view->path($pageItem['route']), 'id' => $pageItem['id'], 'order' => $pageItem['order'] ?? 99];
}

// 3) Dropdown children (Volby, Kam vyrazit, Nabídka práce, Kamery, Komerční sdělení, TV program)
foreach ($nav['submenu'] as $item) {
    if (!isset($item['dropdown'])) { continue; }
    foreach ($item['dropdown'] as $child) {
        $items[] = $child;
    }
    // 4) Page children z menuPageWeb-15 (HbbTV, Jak naladit)
    foreach ($pageDropdown as $pageItem) {
        if (!($pageItem['visible'] ?? 1)) { continue; }
        if (isset($pageItem['pages'])) {
            foreach ($pageItem['pages'] as $child) {
                if (!($child['visible'] ?? 1)) { continue; }
                $items[] = ['label' => $child['label'], 'url' => $view->path($child['route']), 'id' => $child['id']];
            }
        }
    }
}

// Seřadíme podle order (stabilní řazení zachová pořadí u stejného order)
usort($items, fn($a, $b) => ($a['order'] ?? 99) <=> ($b['order'] ?? 99));

$left  = array_slice($items, 0, 5);
$right = array_slice($items, 5);
?>
<div class="d-lg-none regions">
    <nav aria-label="Hlavní nabídka">
        <ul class="nav nav-pills">
            <?php foreach ($left as $item) { ?>
                <li<?= isset($item['id']) ? ' id="' . htmlspecialchars($item['id']) . '"' : '' ?>>
                    <a class="d-flex align-items-center text-4 font-weight-normal bg-hover-primary text-hover-light text-no-uppercase nav-link text-light<?= isset($item['url']) && str_starts_with($currentPath, $item['url']) ? ' active' : '' ?>"
                       href="<?= htmlspecialchars($item['url'] ?? '#') ?>"
                       <?= isset($item['target']) ? 'target="' . $item['target'] . '"' : '' ?>>
                        <?= $item['label'] ?>
                    </a>
                </li>
            <?php } ?>
        </ul>
    </nav>
</div>
<?php if ($right) { ?>
<div class="pages-mobile-menu d-lg-none w-50 float-end">
    <nav aria-label="Hlavní nabídka – pokračování">
        <ul class="nav nav-pills mobile-ham-right">
            <?php foreach ($right as $item) { ?>
                <li<?= isset($item['id']) ? ' id="' . htmlspecialchars($item['id']) . '"' : '' ?>>
                    <a class="d-flex align-items-center text-4 font-weight-normal bg-hover-primary text-hover-light text-no-uppercase nav-link text-light<?= isset($item['url']) && str_starts_with($currentPath, $item['url']) ? ' active' : '' ?>"
                       href="<?= htmlspecialchars($item['url'] ?? '#') ?>"
                       <?= isset($item['target']) ? 'target="' . $item['target'] . '"' : '' ?>>
                        <?= $item['label'] ?>
                    </a>
                </li>
            <?php } ?>
        </ul>
    </nav>
</div>
<?php } ?>
