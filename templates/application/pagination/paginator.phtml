<?php
/** @var string $route */
/** @var int $page */
/** @var int $total */
/** @var int $limit */
/** @var array $routeParams */

$routeParams = $routeParams ?? [];
$pageCount   = (int) ceil($total / $limit);

if ($pageCount <= 1) {
    return;
}

$previous     = $page > 1 ? $page - 1 : null;
$next         = $page < $pageCount ? $page + 1 : null;
$pagesInRange = range(max(1, $page - 4), min($pageCount, $page + 4));

$urlFor = fn(int $p): string => $view->path($route, $routeParams + ['strana' => $p]);

?>
<ul class="pagination">

    <!-- Previous page link -->
    <?php if (isset($previous)) { ?>
        <li class="page-item">
            <a class="page-link" href="<?= $urlFor($previous) ?>">
                <i class="fa fa-angle-double-left"></i>
            </a>
        </li>
    <?php } else { ?>
        <li class="page-item disabled">
            <a class="page-link" href="#">
                <i class="fa fa-angle-double-left"></i>
            </a>
        </li>
    <?php } ?>

    <!-- First page link -->
    <?php if (isset($previous) && $page > 4) { ?>
        <li class="page-item">
            <a class="page-link" href="<?= $urlFor(1) ?>">
                1
            </a>
        </li>
        <li class="page-item">
            ...
        </li>
    <?php } ?>

    <!-- Numbers -->
    <?php foreach ($pagesInRange as $p) { ?>
        <?php if ($p !== $page) { ?>
            <li class="page-item">
                <a class="page-link" href="<?= $urlFor($p) ?>">
                    <?= $p ?>
                </a>
            </li>
        <?php } else { ?>
            <li class="page-item active">
                <a class="page-link" href="#">
                    <?= $p ?>
                </a>
            </li>
        <?php } ?>
    <?php } ?>

    <!-- Last page link -->
    <?php if (isset($next) && $page < ($pageCount - 4)) { ?>
        <li class="page-item">
            ...
        </li>
        <li class="page-item">
            <a class="page-link" href="<?= $urlFor($pageCount) ?>">
                <?= $pageCount ?>
            </a>
        </li>
    <?php } ?>

    <!-- Next page link -->
    <?php if (isset($next)) { ?>
        <li class="page-item">
            <a class="page-link" href="<?= $urlFor($next) ?>">
                <i class="fa fa-angle-double-right"></i>
            </a>
        </li>
    <?php } else { ?>
        <li class="page-item disabled">
            <a class="page-link" href="#">
                <i class="fa fa-angle-double-right"></i>
            </a>
        </li>
    <?php } ?>

</ul>
