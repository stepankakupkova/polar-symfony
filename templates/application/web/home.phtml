/**
 * Helper: formátování data a času v češtině
 */
function homeFormatDate(string $dateStr): array
{
    try {
        $d = new DateTime($dateStr);
        $today = new DateTime();
        $yesterday = (new DateTime())->modify('-1 day');
        if ($today->format('Y-m-d') === $d->format('Y-m-d')) {
            $day = 'Dnes';
        } elseif ($yesterday->format('Y-m-d') === $d->format('Y-m-d')) {
            $day = 'Včera';
        } else {
            $day = $d->format('j. n. Y');
        }
        return ['day' => $day, 'time' => $d->format('H:i')];
    } catch (Exception) {
        return ['day' => 'NaN', 'time' => 'NaN'];
    }
}

