<?php
/** @var \App\Application\View\ViewHelper $view */

echo '<?xml version="1.0" encoding="UTF-8"?>';

$nav = require dirname(__DIR__, 3) . '/config/navigation.php';

$urls = [
    ['loc' => '/',                  'priority' => '1.0', 'changefreq' => 'always'],
    ['loc' => '/hd',                'priority' => '0.1', 'changefreq' => 'always'],
    ['loc' => '/polar2',            'priority' => '0.1', 'changefreq' => 'always'],
    ['loc' => '/rss',               'priority' => '0.1', 'changefreq' => 'weekly'],
    ['loc' => '/mapa-stranek',      'priority' => '0.1', 'changefreq' => 'weekly'],
    ['loc' => '/sitemap.xml',       'priority' => '0.1', 'changefreq' => 'weekly'],
    ['loc' => '/robots.txt',        'priority' => '0.1', 'changefreq' => 'weekly'],
];

foreach ($nav['regions'] as $region) {
    $urls[] = ['loc' => $region['url'], 'priority' => '0.9', 'changefreq' => 'monthly'];
    foreach ($region['cities'] as $city) {
        $urls[] = ['loc' => $city['url'], 'priority' => '0.8', 'changefreq' => 'monthly'];
    }
}
?>

<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
<?php foreach ($urls as $url) { ?>
    <url>
        <loc>https://<?= $_SERVER['HTTP_HOST'] ?><?= $url['loc'] ?></loc>
        <priority><?= $url['priority'] ?></priority>
        <changefreq><?= $url['changefreq'] ?></changefreq>
    </url>
<?php } ?>
</urlset>
