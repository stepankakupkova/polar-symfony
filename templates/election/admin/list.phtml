        $.post("' . $view->path('admin_election_json_write_set_order') . '",
            {data: data},
            function(json) {
                var notice = new PNotify({
                    title: "Úspěch",
                    text: "Pořadí volebních studií bylo změněno!",
                    type: "success",
                    addclass: "click-2-close",
                    buttons: {sticker: false}
                });
                $("#btblElection").bootstrapTable("refresh", {silent: true});
            },
            "json"
        );
    });'
);
