// Smazání election
$view->addInlineScript(
    '$("#btblElection").on("post-body.bs.table", function (e, data) {
        $(".btblBtnDeleteElection").unbind("click").bind("click", function() {
            var id = $(this).data("video-id");
            $.post("' . $view->path('admin_election_json_list_get_election') . '",
                {id: id},
                function(json) {
                    if (json.success) {
                        $("#modalDanger .card-title").html("Smazat položku");
                        $("#modalDanger .modal-text h4").html("Opravdu chcete smazat položku?<br><strong>\"" + json.election.title + "\"</strong>");
                        $("#modalDanger .modal-text p").html("Všechny závislosti budou smazány. Tuto akci nelze vrátit!");
                        var btnConfirm = $("#modalDanger .card-footer button.modal-confirm");

                        $.magnificPopup.open({
                            items: {src: "#modalDanger"},
                            type: "inline",
                            fixedContentPos: false,
                            fixedBgPos: true,
                            overflowY: "auto",
                            closeBtnInside: true,
                            preloader: false,
                            midClick: true,
                            removalDelay: 300,
                            mainClass: "my-mfp-slide-bottom",
                            modal: true,
                            callbacks: {
                                open: function() {
                                    btnConfirm.unbind("click").click(function(e){
                                        e.preventDefault();
                                        $.post("' . $view->path('admin_election_json_write_delete_election') . '",
                                            {id: id},
                                            function(json) {
                                                if (json.success) {
                                                    var notice = new PNotify({
                                                        title: "Úspěch",
                                                        text: "Položka byla smazána",
                                                        type: "success",
                                                        addclass: "click-2-close",
                                                        buttons: {sticker: false}
                                                    });
                                                    $("#btblElection").bootstrapTable("refresh", {"silent": true});
                                                } else {
                                                    var notice = new PNotify({
                                                        title: "Chyba",
                                                        text: "Položku se nepodařilo smazat",
                                                        type: "error",
                                                        addclass: "click-2-close",
                                                        buttons: {sticker: false}
                                                    });
                                                }
                                                $.magnificPopup.close();
                                            },
                                            "json"
                                        );
                                    });
                                }
                            }
                        });
                    } else {
                        var notice = new PNotify({
                            title: "Chyba",
                            text: "Nepodařilo se načíst informace o položce!",
                            type: "error",
                            addclass: "click-2-close",
                            buttons: {sticker: false}
                        });
                        $.magnificPopup.close();
                        $("#btblElection").bootstrapTable("refresh", {"silent": true});
                    }
                },
                "json"
            );
        });
    });'
);

// Řazení
$view->addInlineScript(
