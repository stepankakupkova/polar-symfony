<?php
$nav = require dirname(__DIR__, 2) . '/config/navigation.php';
$items = $nav['footer'];
$currentUri = $_SERVER['REQUEST_URI'] ?? '';
?>
<ul class="">
    <?php foreach ($items as $item) { ?>
        <?php
        $active = ($item['url'] !== '?cmpscreen' && rtrim($currentUri, '/') === rtrim($item['url'], '/'));
        $class = trim(($item['class'] ?? '') . ' ml-1 text-decoration-none' . ($active ? ' active' : ''));
        $idAttr = $item['id'] ? ' id="' . htmlspecialchars($item['id']) . '"' : '';
        $targetAttr = $item['target'] ? ' target="' . htmlspecialchars($item['target']) . '"' : '';
        ?>
        <li>
            <?php if ($item['icon']) { ?>
                <i class="<?= htmlspecialchars($item['icon']) ?> mr-1" aria-hidden="true"></i>&nbsp;
            <?php } ?>
            <a class="<?= htmlspecialchars($class) ?>"
               href="<?= htmlspecialchars($item['url']) ?>"
               <?= $idAttr ?>
               title="<?= htmlspecialchars($item['label']) ?>"
               <?= $targetAttr ?>><?= htmlspecialchars($item['label']) ?></a>
        </li>
    <?php } ?>
</ul>
