// Url
$view->addInlineScript(
    '$("#btnGetUrl").click(function(e){
        e.preventDefault();
        let title = $("input[name=title]").val();
        if (title === "") {
            var notice = new PNotify({
                title: "Chyba",
                text: "Nejdříve vyplňte název!",
                type: "error",
                addclass: "click-2-close",
                buttons: {
                    sticker: false
                }
            });
        } else {
            let date = $("input[name=date]").val();
            let time = $("input[name=time]").val();
            $.post("' . $view->path('admin_program_json_get_url') . '",
                {
                    title: title,
                    date: date,
                    time: time
                },
                function(json) {
                    if (json.success) {
                        $("input[name=url]").val(json.url);
                    } else {
                        var notice = new PNotify({
                            title: "Chyba",
                            text: "Nepodařilo se načíst informace o\u00a0názvu!",
                            type: "error",
                            addclass: "click-2-close",
                            buttons: {
                                sticker: false
                            }
                        });
                    }
                }, 
                "json"      
            );
        }
    });'
);

