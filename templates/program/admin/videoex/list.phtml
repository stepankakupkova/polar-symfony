                        $("#modalDanger .card-title").html("Odstranit mimořádné video");
                        $("#modalDanger .modal-text h4").html("Opravdu chcete smazat video?<br><strong>\"" + json.video.name + "\"</strong>" );
                        $("#modalDanger .modal-text p").html("Všechny závislosti budou odstraněny. Tuto akci nelze vrátit zpět!");
                        var btnConfirm = $("#modalDanger .card-footer button.modal-confirm");
                        
                        $.magnificPopup.open({
                            items: {src: "#modalDanger"},
                            type: "inline",
                            fixedContentPos: false,
                            fixedBgPos: true,
                            overflowY: "auto",
                            closeBtnInside: true,
                            preloader: false,
                            midClick: true,
                            removalDelay: 300,
                            mainClass: "my-mfp-slide-bottom",
                            modal: true,
                            callbacks: {
                                open: function() {
                                    btnConfirm.unbind("click").click(function(e){
                                        e.preventDefault();
                                        $.post("' . $view->path('admin_program_videoex_json_delete_video') . '",
                                            {
                                                id: id
                                            },
                                            function(json) {
                                                if (json.success) {
                                                    var notice = new PNotify({
                                                        title: "Uloženo",
                                                        text: "Video bylo odstraněno!",
                                                        type: "success",
                                                        addclass: "click-2-close",
                                                        buttons: {
                                                            sticker: false
                                                        }
                                                    });
                                                    $("#btblVideo").bootstrapTable("refresh", {"silent": true});
                                                }else{
                                                    var notice = new PNotify({
                                                        title: "Chyba",
                                                        text: "Nelze odstranit video!",
                                                        type: "error",
                                                        addclass: "click-2-close",
                                                        buttons: {
                                                            sticker: false
                                                        }
                                                    });
                                                }
                                                $.magnificPopup.close();
                                            }, 
                                            "json"      
                                        );
                                    });
                                }
                            }
                        });
                    } else {
                        var notice = new PNotify({
                            title: "Chyba",
                            text: "Nelze načíst informace o videu!",
                            type: "error",
                            addclass: "click-2-close",
                            buttons: {
                                sticker: false
                            }
                        });
                        $.magnificPopup.close();
                        $("#btblVideo").bootstrapTable("refresh", {"silent": true});
                    }
                }, 
                "json"      
            );
        });
    });'
);

// Načtení videí
$view->addInlineScript(
    'var btn = $("#btnLoadVideos");
    var modal = $("#modalProgress");
    btn.click(function(e){
        e.preventDefault();
        btn.button("loading");
        modal.find(".card-title").html("Načítání mimořádných videí");
        $.magnificPopup.open({
            items: {src: "#modalProgress"},
            closeOnBgClick: false,
            callbacks: {
                close: function() {
                    btn.button("reset");
                },
            }
        });
        startProgress();
    });
    
    function startProgress(){
        modal.find(".progress-bar").css("width", "0%");
        modal.find(".percent").html("");
        modal.find(".timeTaken").html("0s celkem");
        modal.find(".timeRemaining").html("0s zbývá");
        modal.find(".modal-text .scrollable-content").html("Čekejte prosím...");
        modal.find(".btn-close").hide();
        modal.find("button.modal-dismiss").attr("disabled", true);
        var iFrame = document.createElement("iframe");
        iFrame.className = "loadData";
        document.getElementsByTagName("body")[0].appendChild(iFrame);
        iFrame.src = "' . $view->path('admin_program_videoex_json_load_videos') . '?cron=false";
    }
    function updateProgress(data){
        modal.find(".progress-bar").css("width", Math.round(data.percent) + "%");
        modal.find(".percent").html(Math.round(data.percent));
        modal.find(".timeTaken").html(data.timeTaken + "s celkem");
        if (data.timeRemaining) modal.find(".timeRemaining").html(((data.timeRemaining)?data.timeRemaining:0) + "s zbývá");
        if (data.text) modal.find(".modal-text .scrollable-content").prepend(data.text + "<br />");
    }
    function finishProgress(){
        modal.find(".progress-bar").css("width", "100%");
        modal.find(".percent").html("100");
        modal.find(".btn-close").show();
        modal.find("button.modal-dismiss").removeAttr("disabled");
        modal.find(".timeRemaining").html("");
        $(".modal-text .nano").nanoScroller();
        $("[data-toggle=\"tooltip\"]").tooltip();
        $("#btblVideo").bootstrapTable("refresh", {"silent": true});
    }'
);
