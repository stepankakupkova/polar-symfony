                function imageFormatter(value) {
                    if (value) {
                        let randNum = Math.floor(Math.random() * 999) + 1;
                        return '<a class="image-popup-no-margins cur-zoom-in" href="/data/mimoradne/thumbs/' + value + '.jpg?' + randNum + '">' +
                            '<img src="/data/mimoradne/thumbs/' + value + '-260x146.jpg?' + randNum + '" height="48" alt="" />' +
                            '</a>';
                    }
                    return '';
                }

                function showedFormatter(value) {
                    if (value) {
                        return number_format(value, 0, ',', ' ') + " x";
                    } else {
                        return "0 x";
                    }
                }
