$view->addInlineScript(
    'function loadProgram(dateStr) {
            $.post("' . $view->path('program_web_json_get_program') . '?date=" + dateStr,
                function(json) {
                    $("#program").html(json.content);
                    $(".page-header h1 strong").html(moment(json.date).format("LL"));
                },
                "json"
            );
        }

        $(".datepicker_cal").datepicker({
            language: "cs",
            todayHighlight: true,
            todayBtn: "linked",
            weekStart: 1,
            format: "dd.mm.yyyy",
        }).on("changeDate", function(e){
            var date = new Date(e.date);
            var d = String(date.getDate()).padStart(2, "0");
            var m = String(date.getMonth() + 1).padStart(2, "0");
            var y = date.getFullYear();
            loadProgram(y + "-" + m + "-" + d);
        });
        $(".datepicker_cal").datepicker("setDate", new Date());

        // Keyboard focus indicator – přidáme třídu .kb-focused na aktuální den při pohybu šipkami
        $(".datepicker_cal").on("keydown", function(e) {
            var arrowKeys = [37, 38, 39, 40];
            if ($.inArray(e.keyCode, arrowKeys) === -1) return;
            var $input = $(this);
            setTimeout(function() {
                var dp = $input.data("datepicker");
                if (!dp) return;
                var vd = dp.viewDate;
                if (!vd) return;
                var $picker = $(".datepicker.dropdown-menu:visible");
                $picker.find("td.day").removeClass("kb-focused");
                $picker.find("td.day").each(function() {
                    var day = parseInt($(this).text(), 10);
                    if (!isNaN(day) && day === vd.getDate()
                        && !$(this).hasClass("old") && !$(this).hasClass("new")) {
                        $(this).addClass("kb-focused");
                    }
                });
            }, 0);
        });'
);

