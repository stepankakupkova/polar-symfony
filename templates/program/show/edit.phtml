                    <?php for ($i = 0; $i < 10; $i++) { ?>
                        function dataFormatter<?= $i ?>(value, row) {
                            if (value[<?= $i ?>] !== undefined) {
                                let time = value[<?= $i ?>].time;
                                if (value[<?= $i ?>].premiere === '1') {
                                    return '<span class="btnEdit text-danger" data-id="' + value[<?= $i ?>].id + '" data-premiere="' + value[<?= $i ?>].premiere + '" data-value="' + value[<?= $i ?>].time + '" data-day="' + row.day + '">' + time + '</span>';
                                } else {
                                    return '<span class="btnEdit" data-id="' + value[<?= $i ?>].id + '" data-premiere="' + value[<?= $i ?>].premiere + '" data-value="' + value[<?= $i ?>].time + '" data-day="' + row.day + '">' + time + '</span>';
                                }
                            } else {
                                return '<i class="fa fa-fw fa-pencil-alt btnEdit text-success cur-pointer" data-day="' + row.day + '"></i>';
                            }
                        }
