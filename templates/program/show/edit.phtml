);

// Smazání obrázku (klik na ikonu)
$view->addInlineScript(
    '$("#image .image-outer-container .image-inner-container .delete-button").click(function(e){
        $.post("' . $view->path('admin_program_show_json_set_default_image') . '",
            {
                show_id: ' . $show['id'] . ',
                field: "image"
            },
            function(json) {
                if (json.success) {
                    var notice = new PNotify({
                        title: "Úspěch",
                        text: "Obrázek pořadu byl nastaven na výchozí",
                        type: "success",
                        addclass: "click-2-close",
                        buttons: {
                            sticker: false
                        }
                    });
                    $("input[name=image]").val(json.url);
                    $("#image .image-outer-container img").attr("src", "/" + json.url);
                } else {
                    var notice = new PNotify({
                        title: "Chyba",
                        text: "Nepodařilo se nastavit obrázek pořadu na výchozí",
                        type: "error",
                        addclass: "click-2-close",
                        buttons: {
                            sticker: false
                        }
                    });
                }
            }, 
            "json"      
        );
    });'
);

$view->addInlineScript(
    '$("#btblTimes").on("post-body.bs.table", function (e, data) {
        $(".btnEdit").unbind("click").bind("click", function() {
            var id = $(this).data("id");
            var day = $(this).data("day");
            var value = $(this).data("value");
            var premiere = $(this).data("premiere");
            if (id == undefined) {
                $("#modalTime .card-title").html("Přidat čas");
                id = "";
                value = "";
                premiere = 0;
            } else {
                $("#modalTime .card-title").html("Upravit čas");
            }
            
            $("#modalTime #time").val(value);
            if (premiere) {
                $("#modalTime .ios-switch").addClass("on");
            } else {
                $("#modalTime .ios-switch").addClass("off");
            }
            
            $.magnificPopup.open({
                items: {
                    src: "#modalTime"
                },
                type: "inline",
                fixedContentPos: false,
                fixedBgPos: true,
                overflowY: "auto",
                closeBtnInside: true,
                preloader: false,
                midClick: true,
                removalDelay: 300,
                mainClass: "my-mfp-slide-bottom",
                modal: true,
                callbacks: {
                    open: function() {
                        $("#modalTime #btnSaveTime").unbind("click").click(function(e){
                            e.preventDefault();
                            $.post("' . $view->path('admin_program_show_json_set_time') . '",
                                {
                                    id: id,
                                    show_id: ' . $show['id'] . ',
                                    day: day,
                                    value: $("#modalTime #time").val(),
                                    premiere: $("#modalTime .ios-switch").hasClass("on")
                                },
                                function(json) {
                                    if (json.success == true) {
                                        var notice = new PNotify({
                                            title: "Úspěch",
                                            text: "Čas byl uložen!",
                                            type: "success",
                                            addclass: "click-2-close",
                                            buttons: {
                                                sticker: false
                                            }
                                        });
                                        $.magnificPopup.close();
                                        $("#btblTimes").bootstrapTable("refresh", {"silent": true});
                                    }else{
                                        $(function(){
                                            new PNotify({
                                                title: "Chyba",
                                                text: "Data nebyla uložena!",
                                                type: "error",
                                                hide: true,
                                                buttons: {
                                                    sticker: true
                                                }
                                            });
                                        });
                                    }
                                    $.magnificPopup.close();
                                },
                                "json"
                            );
                        });
                    }
                }
            });
        });
    });'
);
